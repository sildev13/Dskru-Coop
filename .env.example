# Template only. Copy to .env.local and fill your credentials there.
# Explicitly choose demo (single-process local JSON) or firestore.
DATA_BACKEND=demo
# Firestore first-account setup only: random secret of at least 24 characters.
# Remove after creating the first administrator. Not needed when migrating existing accounts.
ADMIN_SETUP_TOKEN=
# Optional legacy defaults; dashboard PromptPay settings take precedence.
PROMPTPAY_ID=
PROMPTPAY_NAME=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional absolute path for demo storage. Unused in Firestore mode.
DEMO_DATA_PATH=
# Optional fixed path for server settings saved from /admin. Defaults to .data/server-config.json.
# Use a private persistent writable disk on a single server; saved overrides take effect after restart.
SYSTEM_CONFIG_PATH=

# Omise PromptPay: live for real sales; test requires DATA_BACKEND=demo.
PAYMENT_MODE=live
OMISE_SECRET_KEY=
# Base64 webhook signing secret from the matching Omise test/live dashboard.
OMISE_WEBHOOK_SECRET=
# Public HTTPS URL ending in /api/payments/omise/webhook
PAYMENT_WEBHOOK_URL=
# Random secret >=24 characters. Schedule GET /api/payments/reconcile every minute
# with Authorization: Bearer <CRON_SECRET> to recover missed webhooks.
CRON_SECRET=
